---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import { Image } from 'astro:assets';
import heroImage from '@images/mylonics-electrical.jpg';
import mylNrfUsbImage from '@images/products/myl-nrf-usb-1.0-front.png';
import mylRpUsbImage from '@images/products/myl-rp-usb-1.0-front.png';
import mylStmUsbImage from '@images/products/myl-stm-usb-1.0-front.png';
import zephyrIdeImage from '@images/tools/zephyr-ide.png';
import structFrameImage from '@images/tools/struct-frame.png';
import bmpDebugImage from '@images/tools/bmp-debug.png';
import features from '@data/features.json';
import { SITE, ORGANIZATION_SCHEMA } from '@data/constants';
import { withBase } from '@utils/path';

const pageTitle: string = `${SITE.title} - Electrical Design and Contracting`;

const productShowcase = [
  { src: mylNrfUsbImage, alt: 'myl-nrf-usb module', name: 'myl-nrf-usb' },
  { src: mylRpUsbImage, alt: 'myl-rp-usb module', name: 'myl-rp-usb' },
  { src: mylStmUsbImage, alt: 'myl-stm-usb module', name: 'myl-stm-usb' },
];

const toolShowcase = [
  { src: zephyrIdeImage, alt: 'IDE for Zephyr logo', name: 'IDE for Zephyr', anchor: 'zephyr-ide' },
  { src: structFrameImage, alt: 'Struct Frame logo', name: 'Struct Frame', anchor: 'struct-frame' },
  { src: bmpDebugImage, alt: 'BMP Debug logo', name: 'BMP Debug', anchor: 'bmp-debug' },
];
---

<MainLayout
  title={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': 'https://mylonics.com',
        url: 'https://mylonics.com',
        name: pageTitle,
        description: SITE.description,
        isPartOf: {
          '@type': 'WebSite',
          url: 'https://mylonics.com',
          name: SITE.title,
          description: SITE.description,
        },
        about: { '@id': ORGANIZATION_SCHEMA['@id'] },
        inLanguage: 'en-US',
      },
      ORGANIZATION_SCHEMA,
    ],
  }}
>
  <HeroSection
    title=`Electrical &amp; Embedded Systems <span class="text-blue-500 dark:text-blue-400">Design Services</span>`
    subTitle="Professional electrical and embedded systems design services in Edmonton, Alberta. Specializing in PCB design, industrial automation, robotics, and firmware development."
    primaryBtn="Get in Touch"
    primaryBtnURL="/contact"
    secondaryBtn="Learn More"
    secondaryBtnURL="/about"
    src={heroImage}
    alt="Circuit board - Mylonics electrical engineering"
  />

  <FeaturesGeneral
    title="Our Services"
    subTitle="We engage in close collaboration with our clients. Through every step of the design process we help to develop and deliver a solution that is feasible from an engineering and business perspective."
    features={features}
  />

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold text-balance text-neutral-800 md:text-3xl dark:text-neutral-200">
          Hardware, Designed In-House
        </h2>
        <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
          Alongside client work, we design and build our own hardware products — from castellated
          MCU modules to industrial communication adapters and field survey equipment.
        </p>
        <a
          href={withBase('/products')}
          class="mt-6 inline-flex items-center gap-x-2 rounded-full bg-blue-500 px-6 py-3 text-base font-bold text-white transition duration-300 hover:bg-blue-400 dark:bg-blue-600 dark:hover:bg-blue-500"
        >
          View Our Products
        </a>
      </div>
      <div class="flex items-center justify-center gap-4 rounded-xl bg-neutral-50 p-8 dark:bg-neutral-100">
        {
          productShowcase.map(product => (
            <Image
              src={product.src}
              alt={product.alt}
              class="w-1/3 object-contain"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8">
    <div class="rounded-xl border border-neutral-200 bg-white p-8 dark:border-neutral-700 dark:bg-neutral-800">
      <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
        <div class="text-center sm:text-left">
          <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
            Open Source Tools
          </h2>
          <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
            We build and maintain free, open source tooling for embedded development.
          </p>
        </div>
        <div class="flex items-center gap-8">
          {
            toolShowcase.map(tool => (
              <a
                href={withBase(`/tools#${tool.anchor}`)}
                class="flex flex-col items-center gap-2 text-center"
              >
                <Image src={tool.src} alt={tool.alt} class="h-10 w-auto object-contain" />
                <span class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">
                  {tool.name}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="relative mx-auto max-w-[85rem] px-4 pt-10 pb-24 sm:px-6 lg:px-8">
    <div class="mx-auto mt-5 max-w-xl text-center">
      <h2 class="block text-4xl leading-tight font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200">
        Ready to Start Your Project?
      </h2>
    </div>
    <div class="mx-auto mt-5 max-w-3xl text-center">
      <p class="text-lg text-pretty text-neutral-600 dark:text-neutral-400">
        Whether you are a startup or an established business, if you are looking for electrical or embedded systems help, we'd love to hear from you.
      </p>
    </div>
    <div class="mt-8 flex justify-center gap-3">
      <a
        href={withBase('/contact')}
        class="inline-flex items-center gap-x-2 rounded-full bg-blue-500 px-6 py-3 text-base font-bold text-white transition duration-300 hover:bg-blue-400 dark:bg-blue-600 dark:hover:bg-blue-500"
      >
        Contact Us
      </a>
      <a
        href={withBase('/services')}
        class="inline-flex items-center gap-x-2 rounded-full border border-neutral-400 bg-transparent px-6 py-3 text-base font-bold text-neutral-700 transition duration-300 hover:bg-neutral-200 dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-700"
      >
        Our Services
      </a>
    </div>
  </section>
</MainLayout>
