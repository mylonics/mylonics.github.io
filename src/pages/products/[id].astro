---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE, ORGANIZATION_SCHEMA } from '@data/constants';
import Icon from '@components/ui/icons/Icon.astro';
import { Image } from 'astro:assets';
import { products } from '@data/products';
import { withBase } from '@utils/path';

export function getStaticPaths() {
  return products.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

const pageTitle = `${product.name} | ${SITE.title}`;
const metaDescription = product.summary;
const ogTitle = pageTitle;
const canonicalPath = `/products/${product.id}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `https://mylonics.com${canonicalPath}`,
    url: `https://mylonics.com${canonicalPath}`,
    name: product.name,
    description: metaDescription,
    brand: { '@id': ORGANIZATION_SCHEMA['@id'] },
    ...(product.images && { image: product.images.map(image => image.src.src) }),
  }}
>
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <nav class="mb-8 flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400">
      <a href={withBase('/products')} class="hover:text-blue-600 dark:hover:text-blue-400">
        Products
      </a>
      <span>/</span>
      <span class="text-neutral-700 dark:text-neutral-300">{product.name}</span>
    </nav>

    <div class="flex flex-col gap-10 lg:flex-row">
      <div class="flex shrink-0 flex-col items-center justify-start lg:w-80">
        {product.images ? (
          <div class="flex w-full flex-col gap-4 rounded-xl bg-neutral-50 p-6 dark:bg-neutral-100">
            {product.images.map(image => (
              <Image src={image.src} alt={image.alt} class="w-full object-contain" />
            ))}
          </div>
        ) : (
          <div class="flex aspect-square w-full flex-col items-center justify-center gap-4 rounded-xl bg-neutral-50 p-6 text-center dark:bg-neutral-800/60">
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-blue-100 text-blue-500 dark:bg-blue-900/40 dark:text-blue-400">
              <Icon name={product.icon} />
            </div>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              Product renders coming soon
            </p>
          </div>
        )}
        <a
          href={withBase('/contact')}
          class="mt-6 inline-flex w-full items-center justify-center gap-x-2 rounded-full bg-blue-500 px-6 py-3 text-base font-bold text-white transition duration-300 hover:bg-blue-400 dark:bg-blue-600 dark:hover:bg-blue-500"
        >
          <Icon name="envelopeOpen" />
          Contact to Enquire
        </a>
      </div>

      <div class="flex-1">
        <span class="inline-flex w-fit items-center rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-900/40 dark:text-blue-400">
          {product.badge}
        </span>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-200">
          {product.name}
        </h1>
        <p class="mt-1 text-lg font-semibold text-neutral-500 dark:text-neutral-400">
          {product.subtitle}
        </p>

        <div class="mt-6 space-y-4 text-pretty text-neutral-700 dark:text-neutral-300">
          {product.description.map(paragraph => <p>{paragraph}</p>)}
        </div>

        <ul class="mt-6 grid gap-2 sm:grid-cols-2">
          {product.highlights.map(item => (
            <li class="flex items-start gap-2 text-sm text-neutral-600 dark:text-neutral-400">
              <span class="mt-0.5 shrink-0 text-blue-500 dark:text-blue-400">
                <Icon name="checkCircle" />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        {product.variants && (
          <div class="mt-10">
            <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">Variants</h2>
            <div class="mt-4 overflow-x-auto rounded-xl border border-neutral-200 dark:border-neutral-700">
              <table class="min-w-full divide-y divide-neutral-200 dark:divide-neutral-700">
                <thead class="bg-neutral-50 dark:bg-neutral-800/60">
                  <tr>
                    {product.variantColumns?.map(column => (
                      <th class="px-4 py-3 text-left text-xs font-semibold tracking-wider text-neutral-500 uppercase dark:text-neutral-400">
                        {column}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-neutral-200 bg-white dark:divide-neutral-700 dark:bg-neutral-800">
                  {product.variants.map(variant => (
                    <tr>
                      <td class="px-4 py-3 text-sm font-semibold text-neutral-800 dark:text-neutral-200">
                        {variant.name}
                      </td>
                      {product.variantColumns?.slice(1).map(column => (
                        <td class="px-4 py-3 text-sm text-neutral-600 dark:text-neutral-400">
                          {variant.attributes[column]}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {product.optionGroups && (
          <div class="mt-10 grid gap-6 sm:grid-cols-2">
            {product.optionGroups.map(group => (
              <div class="rounded-xl border border-neutral-200 p-5 dark:border-neutral-700">
                <h2 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
                  {group.label}
                </h2>
                <ul class="mt-3 space-y-2">
                  {group.options.map(option => (
                    <li class="flex items-start gap-2 text-sm text-neutral-600 dark:text-neutral-400">
                      <span class="mt-0.5 shrink-0 text-blue-500 dark:text-blue-400">
                        <Icon name="checkCircle" />
                      </span>
                      <span>{option}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
</MainLayout>
