---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import Icon from '@components/ui/icons/Icon.astro';
import { Image } from 'astro:assets';
import { products } from '@data/products';
import { withBase } from '@utils/path';

const pageTitle: string = `Products | ${SITE.title}`;
const metaDescription =
  'Explore Mylonics hardware products for embedded systems and industrial applications, including myl-modules, an industrial USB to 3x CAN adapter, an RTK ground station, and myl-debug-probe. Contact us to enquire about availability and custom configurations.';
const ogTitle = pageTitle;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://mylonics.com/products',
    url: 'https://mylonics.com/products',
    name: pageTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://mylonics.com',
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'en-US',
  }}
>
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-2xl text-center">
      <h1
        class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        Products
      </h1>
      <p class="mt-4 text-pretty text-lg text-neutral-600 dark:text-neutral-400">
        Hardware designed and built by Mylonics for embedded systems and industrial applications.
        Contact us to enquire about pricing, availability, or custom configurations.
      </p>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      {
        products.map(product => (
          <a
            id={product.id}
            href={withBase(`/products/${product.id}`)}
            class="group flex flex-col overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm transition duration-300 hover:shadow-md dark:border-neutral-700 dark:bg-neutral-800"
          >
            {product.images ? (
              <div class="flex h-48 items-center justify-center gap-4 bg-neutral-50 p-6 dark:bg-neutral-100">
                {product.images.slice(0, 3).map(image => (
                  <Image
                    src={image.src}
                    alt={image.alt}
                    class="h-full w-auto max-w-[30%] object-contain"
                  />
                ))}
              </div>
            ) : (
              <div class="flex h-48 items-center justify-center bg-neutral-50 dark:bg-neutral-900/40">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-blue-100 text-blue-500 dark:bg-blue-900/40 dark:text-blue-400">
                  <Icon name={product.icon} />
                </div>
              </div>
            )}
            <div class="flex grow flex-col p-6">
              <span class="mb-2 inline-flex w-fit items-center rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-900/40 dark:text-blue-400">
                {product.badge}
              </span>
              <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
                {product.name}
              </h2>
              <p class="mt-1 text-sm font-semibold text-neutral-500 dark:text-neutral-400">
                {product.subtitle}
              </p>
              <p class="mt-3 grow text-pretty text-neutral-600 dark:text-neutral-400">
                {product.summary}
              </p>
              <span class="mt-4 inline-flex items-center gap-x-1.5 text-sm font-semibold text-blue-600 group-hover:text-blue-500 dark:text-blue-400 dark:group-hover:text-blue-300">
                View details
                <Icon name="arrowRight" />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-16 rounded-xl bg-blue-50 p-8 text-center dark:bg-blue-900/20">
      <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200">
        Don't See What You Need?
      </h2>
      <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
        We also design custom hardware to order. Get in touch to discuss your requirements.
      </p>
      <a
        href={withBase('/contact')}
        class="mt-6 inline-flex items-center gap-x-2 rounded-full bg-blue-500 px-6 py-3 text-base font-bold text-white transition duration-300 hover:bg-blue-400 dark:bg-blue-600 dark:hover:bg-blue-500"
      >
        <Icon name="envelopeOpen" />
        Contact Us
      </a>
    </div>
  </section>
</MainLayout>
